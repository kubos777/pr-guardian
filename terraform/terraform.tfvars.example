# Copy to terraform.tfvars and fill in. NEVER commit terraform.tfvars.
# (It's gitignored below.)

aws_region          = "us-east-1"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# SECURITY: restrict SSH to your IP. Find it with: curl ifconfig.me
ssh_allowed_cidr = "203.0.113.10/32"

# Optional custom domain (A record -> EC2 public IP). Leave "" for nip.io HTTPS.
domain = ""

# --- Secrets (or export as TF_VAR_db_password, TF_VAR_github_token, ...) ---
db_password           = "change-me-strong-password"
github_token          = "github_pat_xxx"
github_webhook_secret = "your-webhook-secret"
groq_api_key          = "gsk_xxx"
gemini_api_key        = "AIza_xxx"
